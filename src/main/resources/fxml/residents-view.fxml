<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nexus.smarthome.presentation.controller.ResidentsController" spacing="12" styleClass="page-root">
 <padding><Insets top="32" right="34" bottom="34" left="34"/></padding>
 <Label text="Residents" styleClass="page-title"/>
 <Label text="Simulate resident arrivals and departures. Presence changes drive house mode, security and climate automation." styleClass="muted-text" wrapText="true"/>
 <VBox fx:id="residentsContainer" spacing="10" styleClass="content-card"/>
 <Label text="Demo behavior: when the first resident arrives, the house switches to HOME and security disarms. When the last resident leaves, the house switches to AWAY and security arms." styleClass="event-detail" wrapText="true"/>
</VBox>
